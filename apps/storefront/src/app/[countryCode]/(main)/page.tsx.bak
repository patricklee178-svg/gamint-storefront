import { Metadata } from "next"

import FeaturedProducts from "@modules/home/components/featured-products"
import Hero from "@modules/home/components/hero"
import LocalizedClientLink from "@modules/common/components/localized-client-link"
import { listCollections } from "@lib/data/collections"
import { getRegion } from "@lib/data/regions"

export const metadata: Metadata = {
  title: "GAMINT | فروشگاه تخصصی گیم",
  description:
    "خرید بازی PS5، اکانت ظرفیتی، پیش‌فروش، گیفت کارت و اشتراک‌های گیمینگ از GAMINT",
}

export default async function Home(props: {
  params: Promise<{ countryCode: string }>
}) {
  const params = await props.params
  const { countryCode } = params

  const region = await getRegion(countryCode)

  const { collections } = await listCollections({
    fields: "id, handle, title",
  })

  if (!region) {
    return null
  }

  const categories = [
    {
      title: "بازی‌های PS5",
      description: "جدیدترین بازی‌ها با ظرفیت‌های مختلف",
      icon: "🎮",
      href: "/store",
    },
    {
      title: "پیش‌فروش",
      description: "بازی‌های آینده را زودتر رزرو کن",
      icon: "🔥",
      href: "/store",
    },
    {
      title: "گیفت کارت",
      description: "شارژ سریع اکانت PlayStation",
      icon: "💳",
      href: "/store",
    },
    {
      title: "PS Plus",
      description: "اشتراک‌های Essential، Extra و Premium",
      icon: "⚡",
      href: "/store",
    },
  ]

  return (
    <main dir="rtl" className="min-h-screen bg-[#07070a] text-white">
      <Hero />

      <section
        id="playstation"
        className="content-container py-16 small:py-20"
      >
        <div className="mb-8 flex items-end justify-between gap-6">
          <div>
            <span className="text-sm font-bold text-purple-400">
              فروشگاه GAMINT
            </span>

            <h2 className="mt-2 text-2xl font-black small:text-3xl">
              چی می‌خوای بازی کنی؟
            </h2>

            <p className="mt-3 text-sm leading-7 text-white/50">
              سریع وارد بخش موردنظرت شو و محصول مناسب رو انتخاب کن.
            </p>
          </div>

          <LocalizedClientLink
            href="/store"
            className="hidden text-sm font-bold text-purple-300 hover:text-purple-200 small:block"
          >
            مشاهده همه محصولات ←
          </LocalizedClientLink>
        </div>

        <div className="grid grid-cols-1 gap-4 small:grid-cols-2 large:grid-cols-4">
          {categories.map((category) => (
            <LocalizedClientLink
              key={category.title}
              href={category.href}
              className="group relative overflow-hidden rounded-2xl border border-white/10 bg-white/[0.035] p-6 transition duration-300 hover:-translate-y-1 hover:border-purple-500/40 hover:bg-white/[0.06]"
            >
              <div className="absolute left-[-30px] top-[-30px] h-24 w-24 rounded-full bg-purple-600/10 blur-2xl transition group-hover:bg-purple-600/20" />

              <div className="relative">
                <div className="mb-7 flex h-12 w-12 items-center justify-center rounded-xl border border-white/10 bg-white/[0.05] text-2xl">
                  {category.icon}
                </div>

                <h3 className="text-lg font-black">{category.title}</h3>

                <p className="mt-2 text-sm leading-6 text-white/45">
                  {category.description}
                </p>

                <div className="mt-6 text-xs font-bold text-purple-300">
                  ورود به بخش ←
                </div>
              </div>
            </LocalizedClientLink>
          ))}
        </div>
      </section>

      <section className="content-container pb-20">
        <div className="rounded-[28px] border border-white/10 bg-white/[0.025] p-5 small:p-8">
          <div className="mb-8">
            <span className="text-sm font-bold text-purple-400">
              انتخاب‌های GAMINT
            </span>

            <h2 className="mt-2 text-2xl font-black small:text-3xl">
              بازی‌های پیشنهادی
            </h2>
          </div>

          {collections && collections.length > 0 ? (
            <ul className="flex flex-col gap-x-6">
              <FeaturedProducts collections={collections} region={region} />
            </ul>
          ) : (
            <div className="flex min-h-48 items-center justify-center rounded-2xl border border-dashed border-white/10 bg-black/20 text-center">
              <div>
                <div className="text-lg font-bold">محصولات GAMINT به‌زودی</div>
                <div className="mt-2 text-sm text-white/40">
                  بازی‌ها و اکانت‌های جدید در حال اضافه شدن هستند.
                </div>
              </div>
            </div>
          )}
        </div>
      </section>
    </main>
  )
}
